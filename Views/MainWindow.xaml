<Window x:Class="YouTubeLiveDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Live Desktop - 설정"
        Width="480" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="재생할 URL / 로컬 동영상 파일" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="찾아보기..." Width="90" Height="28" Margin="8,0,0,0"
                    Click="BrowseButton_Click"/>
            <TextBox x:Name="UrlTextBox" Height="28" VerticalContentAlignment="Center"
                      ToolTip="예: YouTube 라이브 URL, Vimeo URL(https://vimeo.com/...), 또는 컴퓨터에 저장된 동영상 파일 경로"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ApplyButton" Content="적용" Width="90" Height="30" Margin="0,0,8,0" Click="ApplyButton_Click"/>
            <Button x:Name="SaveButton" Content="저장" Width="90" Height="30" Click="SaveButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="대기 중" Foreground="Gray" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="볼륨" Width="80" VerticalAlignment="Center"/>
            <Slider x:Name="VolumeSlider" Width="240" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged"/>
            <TextBlock x:Name="VolumeValueText" Width="40" VerticalAlignment="Center"/>
        </StackPanel>

        <CheckBox Grid.Row="5" x:Name="MuteCheckBox" Content="음소거" Margin="0,0,0,8"
                  Checked="MuteCheckBox_Changed" Unchecked="MuteCheckBox_Changed"/>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <CheckBox x:Name="AutoStartCheckBox" Content="Windows 시작 시 자동 실행"
                      Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
            <TextBlock x:Name="AutoStartWarningText" TextWrapping="Wrap" Foreground="OrangeRed"
                       FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"
                       Text="현재 개발 모드로 실행 중이라 자동 시작을 등록할 수 없습니다. 빌드된 exe 파일로 실행한 뒤 다시 시도해 주세요."/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,4,0,12">
            <TextBlock Text="날씨 지역" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="RegionComboBox" Width="200" Height="26" VerticalContentAlignment="Center"
                      IsEditable="False"
                      ToolTip="목록에서 지역을 선택하세요 (화면 중앙에 날짜/시간과 함께 표시됩니다)"/>
            <Button Content="적용" Width="60" Height="26" Margin="8,0,0,0" Click="RegionApplyButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Text="재생 기록" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="9" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="선택 삭제" Width="80" Height="24" Margin="4,0,0,0" Click="DeleteSelectedHistory_Click"/>
                <Button Content="전체 삭제" Width="80" Height="24" Margin="4,0,0,0" Click="DeleteAllHistory_Click"/>
            </StackPanel>
            <TextBlock Text="체크 후 선택 삭제, 더블클릭하면 다시 엽니다." Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox Grid.Row="10" x:Name="HistoryListBox" Margin="0,0,0,8"
                  MouseDoubleClick="HistoryListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="11" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="설정 창을 닫아도 프로그램은 트레이 아이콘에서 계속 실행됩니다. 완전히 종료하려면 트레이 아이콘 메뉴의 '종료'를 사용하세요."/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="트레이로 최소화" Width="120" Height="30" Click="MinimizeToTray_Click"/>
        </StackPanel>
    </Grid>
</Window>
